# Python environments (not reproducible through git)
.venv/
.venv-gpu/
tabs/.venv-tabs/
__pycache__/
*.pyc

# Working notes stay out of the public repo; the README is the exception
*.md
!README.md

# Portable package / installer (gigabytes)
dist/

